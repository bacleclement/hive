{
  "observe": {
    "logs": {
      "tool": "railway",
      "cmd": "railway logs --last {period}",
      "env": ["RAILWAY_TOKEN"]
    },
    "errors": {
      "tool": "sentry",
      "dsn": "env:SENTRY_DSN",
      "org": "env:SENTRY_ORG",
      "project": "gotchi"
    },
    "metrics": {
      "tool": "psql",
      "conn": "env:DB_READ_REPLICA",
      "queries": {
        "error_rate": "SELECT count(*) FILTER (WHERE level = 'error') * 100.0 / count(*) FROM logs WHERE created_at > now() - interval '{period}'",
        "active_orgs": "SELECT count(DISTINCT id) FROM organizations",
        "active_professionals": "SELECT count(DISTINCT id) FROM professionals",
        "enrichments_today": "SELECT count(*) FROM enrichment_runs WHERE created_at > now() - interval '24h'",
        "db_connections": "SELECT count(*) FROM pg_stat_activity",
        "table_sizes": "SELECT relname, pg_size_pretty(pg_total_relation_size(relid)) FROM pg_catalog.pg_statio_user_tables ORDER BY pg_total_relation_size(relid) DESC LIMIT 10"
      }
    }
  },
  "infra": {
    "deploy": {
      "tool": "railway",
      "cmd": "railway up",
      "env": ["RAILWAY_TOKEN"]
    },
    "db": {
      "tool": "supabase",
      "project": "env:SUPABASE_PROJECT_ID",
      "cmd_prefix": "supabase",
      "env": ["SUPABASE_ACCESS_TOKEN"]
    },
    "dns": {
      "tool": "dns-check",
      "domains": ["gotchi.app"]
    }
  },
  "security": {
    "deps": {
      "tool": "npm-audit",
      "cmd": "pnpm audit --json",
      "severity_threshold": "moderate"
    },
    "auth": {
      "tool": "supabase-rls",
      "cmd": "supabase inspect db policies",
      "env": ["SUPABASE_ACCESS_TOKEN"]
    },
    "secrets": {
      "tool": "gitleaks",
      "cmd": "gitleaks detect --source . --no-git"
    }
  },
  "notify": {
    "telegram": {
      "tool": "telegram-bot",
      "token": "env:HIVE_TG_BOT_TOKEN",
      "human_chat_id": "env:CLEMENT_TG_CHAT_ID"
    },
    "email": {
      "tool": "resend",
      "api_key": "env:RESEND_API_KEY",
      "from": "hive@gotchi.app",
      "to": "env:CLEMENT_EMAIL"
    }
  },
  "build": {
    "test": "pnpm nx run {project}:test",
    "lint": "pnpm nx run {project}:lint",
    "typecheck": "pnpm nx run {project}:typecheck",
    "build": "pnpm nx run {project}:build"
  }
}
